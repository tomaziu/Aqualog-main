# ÁquaLog — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env real (está no .gitignore).

# Banco de dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=senai123
DB_NAME=aqualog

# Alternativa: URL única (tem prioridade sobre DB_* acima)
# DATABASE_URL=mysql://user:password@host:port/database

# Segurança (gere chaves fortes em produção: `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
SECRET_KEY=troque_esta_chave_por_uma_segura_em_producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Mercado Pago (para Pix automático)
# Obtenha em https://www.mercadopago.com.br/developers/panel/credentials
MERCADO_PAGO_ACCESS_TOKEN=

# Pix manual (fallback se não usar Mercado Pago)
PIX_CHAVE=

# Servidor
PORT=8000